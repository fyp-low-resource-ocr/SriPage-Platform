# API
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgres://sripage:sripage@localhost:5432/sripage
DB_SYNCHRONIZE=true

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
WORKER_ENABLED=false
WORKER_CONCURRENCY=1
# Set this on dedicated worker deployments (for example: vlm or non-vlm).
WORKER_METHOD=
# Internal model-service URLs. Each service exposes POST /v1/parse.
VLM_MODEL_URL=http://vlm-model:8080
NON_VLM_MODEL_URL=http://non-vlm-model:8080
MODEL_REQUEST_TIMEOUT_MS=300000
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues

# MinIO used by the local development Compose stack
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniosecret
MINIO_BUCKET=sripage
